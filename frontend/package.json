  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@types/node": "24.13.3",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "eslint": "9.39.5",
    "eslint-plugin-vue": "10.10.0",
    "jiti": "2.7.0",
    "jsdom": "26.1.0",
    "msw": "2.15.0",
