    "qrcode.vue": "3.6.0",
    "vue": "3.5.18",
    "vue-echarts": "7.0.3",
    "vue-router": "4.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.54.1",
    "@types/node": "24.1.0",
    "@vitejs/plugin-vue": "6.0.1",
    "@vue/test-utils": "2.4.6",
    "eslint": "9.31.0",
    "eslint-plugin-vue": "10.3.0",
    "jiti": "2.4.2",
    "jsdom": "26.1.0",
    "msw": "2.10.4",
    "typescript": "5.8.3",
    "typescript-eslint": "8.38.0",
