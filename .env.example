# Copy to .env and replace every required secret before starting Compose. Do not reuse these
# values across environments. Existing MySQL volumes retain their original credentials.
MYSQL_DATABASE=gateway
MYSQL_TEST_DATABASE=gateway_test
MYSQL_USER=gateway
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
GATEWAY_ENVIRONMENT=production
GATEWAY_LOG_LEVEL=INFO
GATEWAY_DATABASE_URL=mysql+asyncmy://gateway:gateway@127.0.0.1:3306/gateway
GATEWAY_TEST_DATABASE_URL=mysql+asyncmy://gateway:gateway@127.0.0.1:3306/gateway_test
GATEWAY_DATABASE_POOL_SIZE=20
GATEWAY_DATABASE_MAX_OVERFLOW=20
GATEWAY_DATABASE_POOL_TIMEOUT_SECONDS=30
GATEWAY_DATABASE_POOL_RECYCLE_SECONDS=1800
GATEWAY_JWT_SECRET=
GATEWAY_JWT_ISSUER=ai-gateway
GATEWAY_JWT_ACCESS_MINUTES=15
GATEWAY_JWT_REFRESH_DAYS=30
GATEWAY_ENCRYPTION_KEY=
# Optional non-interactive administrator bootstrap. Leave all three values empty to initialize
# through /console/register instead; the first registered account becomes administrator.
# If used, email and password must be set together. The optional TOTP secret must be Base32 and
# decode to at least 20 bytes (160 bits).
GATEWAY_BOOTSTRAP_ADMIN_EMAIL=
GATEWAY_BOOTSTRAP_ADMIN_PASSWORD=
GATEWAY_BOOTSTRAP_ADMIN_TOTP_SECRET=
GATEWAY_HTTP_PROXY=
GATEWAY_HTTPS_PROXY=
GATEWAY_NO_PROXY=127.0.0.1,localhost
GATEWAY_ROUTE_FAILURE_THRESHOLD=3
GATEWAY_ROUTE_COOLDOWN_SECONDS=60
GATEWAY_MODEL_SYNC_INTERVAL_SECONDS=3600
GATEWAY_AUDIT_BODY_LIMIT_BYTES=1048576
GATEWAY_AUDIT_LOG_RETENTION_DAYS=30
GATEWAY_AUDIT_LOG_CLEANUP_INTERVAL_SECONDS=3600
